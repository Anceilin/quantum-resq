# QuantumResQ backend configuration.
# NEVER commit real secrets. The local Qiskit Aer simulator needs no credentials.

APP_NAME=Q-RESCUE
ENVIRONMENT=development
VERSION=0.1.0

# Comma-separated allowed CORS origins (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Quantum backend: "aer" (local simulator, default) or "ibm" (optional).
QUANTUM_BACKEND=aer

# Optional IBM Quantum credentials — leave blank to use the local simulator.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_BACKEND_NAME=

# Guardrails.
QAOA_TIMEOUT_SECONDS=60
MAX_QUBITS=16

# --- MongoDB persistence (optional; falls back to in-memory if unreachable) ---
MONGO_URI=mongodb+srv://tsirilahari_db_user:Sirilahari123456@agriplatform.rdgpmdg.mongodb.net/?appName=AgriPlatform
MONGO_DB_NAME=quantumresq

# --- Authentication ---
# Generate your own secret, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
# NEVER commit a real secret. If blank, an ephemeral per-process secret is used.
JWT_SECRET=ei1-zTkC2pWTEC670nSXEEO8xRFrMO7pDYo-vWXpPjY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
